<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Assistente Virtual</title>
  <meta name="description" content="Aprenda a apostar online com segurança! Acesse nosso guia gratuito e comece hoje mesmo.">
  <meta name="keywords" content="apostas esportivas, cassino online, guia de apostas, como apostar, iniciantes">
  <meta name="author" content="doso">
  <meta name="robots" content="index, follow">
  <meta property="og:image" content="https://guia-apostas-mz.vercel.app/guia.webp">
  <meta property="og:title" content="Guia Completo para Iniciantes em Apostas">
  <meta property="og:description" content="Aprenda a apostar online com segurança!">
  <meta property="og:url" content="https://guia-apostas-mz.vercel.app">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_MZ">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Guia Completo para Iniciantes em Apostas">
  <meta name="twitter:description" content="Aprenda a apostar online com segurança!">
  <meta name="twitter:image" content="https://guia-apostas-mz.vercel.app/guia.webp">
  <link rel="icon" href="icon.webp" type="image/webp">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ... estilos mantidos conforme exemplo anterior ... */
  </style>
</head>
<body>
  <div class="chat-container">
    <div class="chat-header"><h1>Assistente Paulo</h1></div>
    <div class="messages" id="messages">
      <div class="message bot-message">Olá, em que posso ajudar?</div>
    </div>
    <div class="questions" id="questions">
      <button class="question-btn" onclick="selectQuestion(this,1)">Olá, Quero receber o guia de apostas e casino online.</button>
      <button class="question-btn" onclick="selectQuestion(this,2)">Olá, quero saber sobre o guia.</button>
    </div>
  </div>

  <script>
    const questionsData = {
      1: { followUp: { options: [
            { text:'Sim', value:101 },
            { text:'Não', value:102 },
            { text:'Voltar ao menu principal', value:0 }
          ] } },
      2: { answer: 'Ótimo, o guia de apostas online é a melhor guia que você pode conhecer hoje. Deseja continuar?', followUp: { options: [
            { text:'Sim', value:101 },
            { text:'Não', value:102 },
            { text:'Voltar ao menu principal', value:0 }
          ] } },
      101: {
        answer: `Ótimo! Crie nova conta aqui para verificar:<br>
                 <a href="https://record.elephantbet.com/_rhoOOvBxBOAWqcfzuvZcQGNd7ZgqdRLk/1/" target="_blank">Criar conta</a><br>
                 E mande comprovante como essa aqui de exemplo:<br>
                 <a href="https://guia-apostas-mz.vercel.app/exemplo.jpg" target="_blank">Ver exemplo</a>`,
        followUp: { options: [ { text:'Voltar ao menu principal', value:0 } ] },
        showFileInput: true
      },
      102: { answer: 'Ok, você pode voltar ao menu.', followUp: { options: [ { text:'Voltar ao menu principal', value:0 } ] } },
      0: { answer: 'Menu principal:', followUp: { options: [
            { text:'Quero receber o guia', value:1 },
            { text:'Quero saber sobre este guia', value:2 }
          ] } }
    };

    async function selectQuestion(btn, id) {
      const data = questionsData[id]; if (!data) return;
      document.querySelectorAll('.question-btn').forEach(b=>b.disabled=true);
      const msgs = document.getElementById('messages');
      // Mensagem do usuário
      const um = document.createElement('div'); um.className='message user-message'; um.innerHTML = btn.textContent;
      msgs.appendChild(um); msgs.scrollTop=msgs.scrollHeight;

      setTimeout(() => handleBotResponse(id, data), 500);
    }

    function handleBotResponse(id, data) {
      const msgs = document.getElementById('messages');
      const q = document.getElementById('questions');
      // Bot resposta inicial
      const bm = document.createElement('div'); bm.className='message bot-message';
      if (data.answer) bm.innerHTML = data.answer; else if (id===1) {
        const pos = Math.floor(Math.random()*316+52);
        bm.innerHTML = `Ótimo, você está na posição ${pos} dos usuários que solicitam o guia hoje, quer continuar?`;
      }
      msgs.appendChild(bm); msgs.scrollTop=msgs.scrollHeight;

      // Limpa opções e mostra input se necessário
      q.innerHTML = '';
      if (data.showFileInput) addFileInput(q, msgs);

      // Adiciona botões followUp
      data.followUp.options.forEach(opt=>{
        const b = document.createElement('button'); b.className='question-btn'; b.textContent=opt.text;
        b.onclick = ()=> selectQuestion(b, opt.value);
        q.appendChild(b);
      });
    }

    function addFileInput(container, msgs) {
      const fi = document.createElement('input'); fi.type='file'; fi.accept='image/*'; fi.id='fileInput'; container.appendChild(fi);
      const sendBtn = document.createElement('button'); sendBtn.className='question-btn'; sendBtn.textContent='Enviar Comprovante';
      sendBtn.onclick = () => handleFileSend(fi, msgs);
      container.appendChild(sendBtn);
    }

    async function handleFileSend(fi, msgs) {
      const file = fi.files[0]; if (!file) return showPopup('Selecione uma imagem antes.');
      fi.disabled=true;
      // Mostra progresso
      const progressMsg = document.createElement('div'); progressMsg.className='message bot-message';
      progressMsg.innerHTML = `<div class="progress-container"><div class="progress-text">Processando comprovante...</div>` +
        `<div class="progress-steps">` +
        `<div class="step uploading active">⏳ Enviando arquivo</div>` +
        `<div class="step processing">📷 Analisando imagem</div>` +
        `<div class="step validating">🔍 Validando dados</div>` +
        `</div></div>`;
      msgs.appendChild(progressMsg); msgs.scrollTop=msgs.scrollHeight;

      try {
        // 1) Envia para OCR no servidor
        const formData = new FormData(); formData.append('file', file);
        const ocrRes = await fetch('/api/ocr', { method:'POST', body:formData });
        progressMsg.querySelector('.processing').classList.add('active');
        const ocrJson = await ocrRes.json();
        const text = ocrJson.text;

        // Mostra texto OCR bruto
        const ocrMsg = document.createElement('div'); ocrMsg.className='message bot-message';
        ocrMsg.innerHTML = `<strong>Texto OCR bruto:</strong><br><pre style="white-space:pre-wrap;">${text.replace(/</g,'&lt;')}</pre>`;
        msgs.appendChild(ocrMsg); msgs.scrollTop=msgs.scrollHeight;

        // 2) Validação
        const validateRes = await fetch('/api/validate', {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ text })
        });
        progressMsg.querySelector('.validating').classList.add('active');
        const result = await validateRes.json();
        progressMsg.remove();

        // 3) Exibe resultado
        const finalMsg = document.createElement('div'); finalMsg.className='message bot-message';
        if (result.approved) {
          finalMsg.innerHTML = `✅ Comprovante aprovado! Aqui está o link para baixar o guia:<br>` +
            `<a href="${result.guideLink}" target="_blank">Acessar Conteúdo</a>`;
        } else {
          let html = `<strong>❌ Erro na validação:</strong><br>${result.message}`;
          if (result.debug) {
            html += `<details style="margin-top:0.5rem;padding:0.5rem;background:#f5f5f5;border-radius:8px;font-size:0.85rem;">` +
              `<summary style="cursor:pointer;color:#374151;">🧐 Mostrar texto extraído pelo OCR</summary>` +
              `<p><strong>Original:</strong><br><code>${result.debug.original.replace(/</g,'&lt;')}</code></p>` +
              `<p><strong>Tratado:</strong><br><code>${result.debug.cleaned.replace(/</g,'&lt;')}</code></p>` +
            `</details>`;
          }
          finalMsg.innerHTML = html;
        }
        msgs.appendChild(finalMsg);
      } catch (err) {
        progressMsg.remove();
        showPopup('Erro: ' + err.message);
        console.error(err);
      }
    }

    function showPopup(message, duration=3000) {
      const popup = document.createElement('div'); popup.className='popup'; popup.textContent=message;
      document.body.appendChild(popup);
      setTimeout(()=>popup.remove(), duration);
    }
  </script>
</body>
</html>
